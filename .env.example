PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
MOBILE_ORIGINS=http://localhost,https://localhost,capacitor://localhost,null
JWT_SECRET=replace-with-at-least-32-random-characters

# Création sécurisée du premier compte administrateur.
INITIAL_ADMIN_USERNAME=Eitan14
INITIAL_ADMIN_PASSWORD=replace-with-a-new-private-password
# Seul ce compte peut créer ou désactiver manuellement des comptes staff.
OWNER_ADMIN_USERNAME=Eitan14

# Bot Discord : ne jamais mettre le token dans l'application mobile.
DISCORD_BOT_TOKEN=
DISCORD_ANNOUNCEMENT_CHANNEL_ID=1256623943494926407
# Configurer une application OAuth2 dans Discord Developer Portal.
# Le Redirect URL doit être identique à celui déclaré chez Discord.
# En production, utilisez l'URL HTTPS fixe du serveur public Termux.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://YOUR_PUBLIC_API_HOST/api/discord/oauth/callback
DISCORD_GUILD_ID=


# Pixel Guide et Pixel Guard utilisent uniquement des fiches locales prédéfinies.
# Aucune clé ou configuration de service extérieur n'est nécessaire.

# URL publique de l'API pour la compilation de l'application.
VITE_API_BASE_URL=http://localhost:3000/api
