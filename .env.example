PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
MOBILE_ORIGINS=http://localhost,https://localhost,capacitor://localhost,null
JWT_SECRET=replace-with-at-least-32-random-characters

# Création sécurisée du premier compte administrateur.
INITIAL_ADMIN_USERNAME=Eitan14
INITIAL_ADMIN_PASSWORD=replace-with-a-new-private-password
# Seul ce compte peut créer ou désactiver manuellement des comptes staff.
OWNER_ADMIN_USERNAME=Eitan14

# Bot Discord : ne jamais mettre le token dans l'application mobile.
DISCORD_BOT_TOKEN=
DISCORD_ANNOUNCEMENT_CHANNEL_ID=1256623943494926407

# Vraies IA Pixel Guide et Pixel Guard.
# La clé doit rester uniquement dans le fichier .env du serveur Termux.
OPENAI_API_KEY=
# Modèle modifiable sans reconstruire l'APK.
OPENAI_MODEL=gpt-5-mini

# URL publique de l'API pour la compilation de l'application.
VITE_API_BASE_URL=http://localhost:3000/api
