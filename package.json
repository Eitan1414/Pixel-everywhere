{
  "name": "pixel-everywhere",
  "version": "0.3.5",
  "private": true,
  "description": "Application mobile communautaire du serveur Discord Pixel Difficult Drawer.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n WEB,API -c cyan,magenta \"vite --host 0.0.0.0\" \"node --watch server/start.mjs\"",
    "start": "node server/start.mjs",
    "termux:upgrade-server": "bash scripts/termux-upgrade-server.sh",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "cap:init": "cap add android",
    "cap:sync": "npm run build && cap sync android",
    "android:debug": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "test": "node --test",
    "mac:build": "npm run build && electron-builder --mac zip --x64 && electron-builder --mac zip --arm64"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/local-notifications": "^7.0.7",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "sql.js": "^1.13.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "concurrently": "^9.2.1",
    "electron": "37.2.0",
    "electron-builder": "26.0.12",
    "vite": "^7.1.2"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.pdd.pixeleverywhere",
    "productName": "Pixel Everywhere",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "www/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.social-networking",
      "icon": "public/assets/alpha-logo.png",
      "artifactName": "Pixel-Everywhere-${version}-macOS-${arch}.${ext}"
    }
  }
}
